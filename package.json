{
  "name": "s-ruk-game",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build_web_game.mjs",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test:e2e": "node tests/game.e2e.mjs",
    "test:mobile": "node tests/mobile.e2e.mjs",
    "package:offline": "npm run build && python3 tools/package_game.py",
    "test:expansion": "node tests/expansion.e2e.mjs",
    "test:state": "node tests/migration.test.mjs",
    "test:rework": "node tests/rework.e2e.mjs",
    "test:navigation": "node tests/navigation.test.mjs",
    "test:gadgets": "node tests/gadgets.e2e.mjs",
    "test:life": "node tests/life.test.mjs",
    "test:offline": "python3 tools/package_game.py && python3 -c \"from zipfile import ZipFile; ZipFile('releases/perekup-second-chance-0.10.zip').extract('play.html','/tmp/s-ruk-offline-check')\" && cp /tmp/s-ruk-offline-check/play.html /tmp/s-ruk-offline-check/index.html && node tests/offline.e2e.mjs",
    "test:resume": "node tests/resume.e2e.mjs",
    "test:progression": "node tests/progression.test.mjs",
    "test:season": "node tests/season-smoke.e2e.mjs",
    "test:shifts": "node tests/shifts.e2e.mjs",
    "test:advanced": "node tests/advanced-repair.e2e.mjs",
    "test:animation": "node tests/animation.e2e.mjs",
    "test:trading": "node tests/trading.test.mjs",
    "test:release": "node tests/release6.e2e.mjs",
    "test:repair-motion": "node tests/repair6.e2e.mjs",
    "test:release-mobile": "node tests/release6-mobile.e2e.mjs",
    "test:release7": "node tests/release7.test.mjs",
    "test:release7-browser": "node tests/release7.e2e.mjs",
    "test:survival": "node tests/survival7.e2e.mjs",
    "capture:marketing": "node tools/capture_marketing.mjs",
    "build:trailer": "python3 tools/make_trailer.py",
    "prepare:android": "npm run package:offline && python3 tools/prepare_android.py",
    "test:release8": "node tests/release8.test.mjs",
    "test:release8-browser": "node tests/release8.e2e.mjs",
    "test:release8-media": "node tests/media8.e2e.mjs",
    "test:release8-touch": "node tests/precision8-mobile.e2e.mjs",
    "test:release9": "node tests/release9.test.mjs",
    "test:release9-browser": "node tests/release9.e2e.mjs",
    "capture:release9": "node tools/render_marketing_09.mjs",
    "build:windows": "npm run package:offline && python3 tools/build_windows.py",
    "test:parcels9": "node tests/parcel9.e2e.mjs",
    "compose:release9": "python3 tools/compose_videos_09.py trailer && python3 tools/compose_videos_09.py tutorial",
    "test:mobile-ui": "node tests/mobile10.e2e.mjs && node tests/mobile10-start.e2e.mjs && node tests/mobile10-dialog.e2e.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "playwright": "1.62.1"
  }
}
